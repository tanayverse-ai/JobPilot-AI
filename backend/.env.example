MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=jobpilot_ai

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

CORS_ORIGINS=["http://localhost:5173"]

# Materials (Feature 4) -- free Cloudinary account, no credit card needed.
# Sign up at https://cloudinary.com, then copy these from your Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Smart Import (Gmail + Gemini) -- both free, no credit card needed.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Redirect URI must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
# Google AI Studio (aistudio.google.com) -> Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Where the OAuth popup shows its "connected" confirmation -- your frontend's URL.
FRONTEND_URL=http://localhost:5173
